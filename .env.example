# Required — Railway sets this automatically when you add the Postgres plugin.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Where the browser app lives, for the magic-link redirect.
APP_URL=https://yuqinggg.github.io/goskulpt

# Optional. Without it, magic links print to the server console (fine for dev).
RESEND_API_KEY=
MAIL_FROM=Skulpt <login@goskulpt.com>

# Optional. Required only for the deslop_rewrite MCP tool.
# NOTE: claude-fable-5 is $10/$50 per MTok — twice Opus 5's $5/$25.
ANTHROPIC_API_KEY=
SKULPT_MODEL=claude-fable-5
